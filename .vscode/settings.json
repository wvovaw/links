{
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "oxc.fmt.configPath": "packages/configurable-codestyle/oxfmt.config.ts",
    "oxc.configPath": "packages/configurable-codestyle/oxlint.config.ts",
    "prettier.enable": false,
    "eslint.enable": false,
    "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit",
        "source.removeUnusedImports": "explicit"
    },
    "[javascript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[json]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[jsonc]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[vue]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[markdown]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[yaml]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "files.associations": {
        "*.css": "css",
        "*.vue": "vue"
    }
}
