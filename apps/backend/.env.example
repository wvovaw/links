# Backend environment. Nothing loads this file: every variable is read from `process.env` at its
# point of use, with the value below as the default — set one only to change it.

# Where uploaded files are written. A relative path resolves against the working directory.
UPLOADS_PATH=uploads/avatars
IMAGES_PATH=uploads/images
ASSETS_PATH=uploads/assets

# Largest accepted image upload, in bytes. multer refuses a bigger file before anything is written.
MAX_IMAGE_BYTES=5242880

# Largest accepted video, audio and document upload, in bytes. An asset answers to the cap of its
# own kind: video first, then audio, then everything else.
MAX_VIDEO_BYTES=52428800
MAX_AUDIO_BYTES=20971520
MAX_DOCUMENT_BYTES=20971520
