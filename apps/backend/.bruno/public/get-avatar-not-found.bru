meta {
  name: Get Avatar Not Found
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/storage/avatars/:fileId
}

params:path {
  fileId: "non-existent-file-id"
}

tests {
  test("should return 404 Not Found", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("should return error message", function () {
    const body = res.getBody();
    expect(body).to.have.property("message");
  });
}

docs {
  Attempt to get an avatar that does not exist.

  **Response:** 404 — Avatar not found
}
