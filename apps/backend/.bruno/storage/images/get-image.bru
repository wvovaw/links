meta {
  name: Get Image
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/storage/images/{{image_file_id}}
  auth: none
}

tests {
  test("should return 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return image file", function () {
    const contentType = res.getHeader("content-type");
    expect(contentType).to.satisfy(function (v) {
      return v && (v.includes("image/") || v.includes("application/octet-stream"));
    });
  });
}

docs {
  Retrieve an uploaded image by file ID.

  **Auth:** None (public)

  **Path params:**
  - `fileId` (string, required) — image file ID

  **Response:** 200 — Image file
}
