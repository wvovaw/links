meta {
  name: Upload Image No Auth
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/storage/images
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(test-image.jpg) @contentType(image/jpeg)
}

tests {
  test("should return 401 Unauthorized", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Upload an image without authentication.
  
  **Response:** 401 — Unauthorized
}
