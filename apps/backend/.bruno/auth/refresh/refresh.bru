meta {
  name: Refresh Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refresh_token}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setEnvVar("refresh_token", body.refreshToken);
  
    const setCookie = res.getHeader("set-cookie");
    const cookieStr = Array.isArray(setCookie) ? setCookie[0] : setCookie;
    if (cookieStr) {
      const match = cookieStr.match(/access_token=([^;]+)/);
      if (match) {
        bru.setEnvVar("access_token", match[1]);
      }
    }
  }
}

tests {
  test("should return 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should return user and new refreshToken", function () {
    const body = res.getBody();
    expect(body).to.have.property("user");
    expect(body).to.have.property("refreshToken");
    expect(body.user).to.have.property("id");
    expect(body.refreshToken).to.be.a("string").and.to.not.be.empty;
  });
  
  test("should set new access_token cookie", function () {
    const setCookie = res.getHeader("set-cookie");
    const cookieStr = Array.isArray(setCookie) ? setCookie.join("; ") : setCookie;
    expect(cookieStr).to.contain("access_token=");
  });
}

docs {
  Refresh the access token using a refresh token.
  
  **Request body:**
  - `refreshToken` (string, required) — valid refresh token
  
  **Response:** 200 — `{ user: UserDto, refreshToken: string }`
  Sets a new `access_token` HTTP-only cookie.
  
  **Post-response script:** Updates stored refresh token and access token variables.
}
