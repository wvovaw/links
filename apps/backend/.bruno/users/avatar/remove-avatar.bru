meta {
  name: Remove Avatar
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/users/me/avatar
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("should return 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return user without avatarUrl or with null", function () {
    const body = res.getBody();
    expect(body).to.have.property("id");
    const hasAvatar = body.hasOwnProperty("avatarUrl");
    if (hasAvatar) {
      expect(body.avatarUrl).to.equal(null);
    }
  });
}

docs {
  Remove the current user's avatar.

  **Auth:** Bearer token (required)

  **Response:** 200 — Updated `UserDto` with `avatarUrl: null`
}
