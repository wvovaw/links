meta {
  name: Create Link Invalid Slug Format
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/links
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "slug": "My Invalid Slug!",
    "title": "Invalid Slug Format Title"
  }
}

tests {
  test("should return 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("should return validation error", function () {
    const body = res.getBody();
    expect(body).to.have.property("message");
  });
}

docs {
  Attempt to create a link with invalid slug characters (uppercase, spaces, special chars).

  **Response:** 400 — Validation error
}
