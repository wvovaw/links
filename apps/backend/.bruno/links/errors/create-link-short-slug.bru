meta {
  name: Create Link Short Slug
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/links
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "slug": "ab",
    "title": "Short Slug Test Title"
  }
}

tests {
  test("should return 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("should return validation error", function () {
    const body = res.getBody();
    expect(body).to.have.property("message");
  });
}

docs {
  Attempt to create a link with a slug shorter than 3 characters.

  **Response:** 400 — Validation error
}
