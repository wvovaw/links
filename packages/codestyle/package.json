{
  "name": "codestyle",
  "version": "1.0.0",
  "private": true,
  "description": "Shared codestyle configuration",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./oxlint": "./oxlint.config.ts",
    "./oxfmt": "./oxfmt.config.ts"
  },
  "scripts": {
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:fix": "oxlint --config oxlint.config.ts . --fix",
    "fmt": "oxfmt --config oxfmt.config.ts --check .",
    "fmt:write": "oxfmt --config oxfmt.config.ts --write ."
  },
  "devDependencies": {
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0"
  }
}
