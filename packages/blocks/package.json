{
  "name": "@links/blocks",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.mts",
  "exports": {
    ".": {
      "types": "./dist/main.d.mts",
      "import": "./dist/main.mjs"
    }
  },
  "scripts": {
    "prepare": "pnpm run build",
    "dev": "tsdown -w",
    "build": "tsdown",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:fix": "oxlint --config oxlint.config.ts . --fix",
    "fmt": "oxfmt --config oxfmt.config.ts --check .",
    "fmt:write": "oxfmt --config oxfmt.config.ts --write .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "codestyle": "workspace:*",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
