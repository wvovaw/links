    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "codestyle": "workspace:*",
    "cva": "npm:class-variance-authority@^0.7.0",
    "defu": "^6.1.4",
    "mkdist": "^2.4.1",
