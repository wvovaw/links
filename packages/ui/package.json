{
  "name": "@links/ui",
  "version": "0.4.2",
  "private": true,
  "files": [
    "components.d.ts",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
