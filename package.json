{
  "name": "links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0",
    "pnpm": "^10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "lint": "pnpm -r lint && oxlint --config packages/codestyle/oxlint.config.ts scripts",
    "lint:fix": "pnpm -r lint:fix && oxlint --config packages/codestyle/oxlint.config.ts scripts --fix",
    "fmt": "pnpm -r fmt && oxfmt --config packages/codestyle/oxfmt.config.ts --check AGENTS.md docs scripts .github .vscode",
    "fmt:write": "pnpm -r fmt:write && oxfmt --config packages/codestyle/oxfmt.config.ts --write AGENTS.md docs scripts .github .vscode",
    "test": "pnpm -r test",
    "tickets:check": "node scripts/tickets-check.mjs",
    "verify": "pnpm tickets:check && pnpm lint && pnpm fmt && pnpm build && pnpm test",
    "upg": "taze -r major --no-node-version --no-github-actions",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.0.11",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "taze": "^21.3.0"
  },
  "packageManager": "pnpm@10.34.5"
}
